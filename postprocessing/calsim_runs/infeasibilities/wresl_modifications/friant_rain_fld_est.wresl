! Fix 8b: Zero-area guard for Friant rainflood estimate evaporation
! File: Run/SanJoaquin/Friant/friant_rain_fld_est.wresl, line 15
!
! Problem: TF_est_evap divides by A_MLRTNlast (Millerton surface area from
!   previous timestep). When Fixes 4-7 allow Millerton storage to drop to
!   ~0 TAF, A_MLRTNlast = 0 and WRIMS throws "divided by 0".
!   This file is globally included (all cycles), so any timestep following
!   a near-zero Millerton month will fail.
!
! Fix: Add zeroArea case returning 0.0 when A_MLRTNlast < 0.01 acres.
!   Physically correct: zero reservoir area means zero evaporation.

! --- ORIGINAL (line 15) ---
!define TF_est_evap {value A17last*Friant_est_evap/A_MLRTNlast}

! --- MODIFIED ---
define TF_est_evap {
    case zeroArea {
        condition A_MLRTNlast < 0.01
        value 0.0
    }
    case normalOps {
        condition always
        value A17last*Friant_est_evap/A_MLRTNlast
    }
}
